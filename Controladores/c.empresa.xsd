<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <!--Restricciones Personalizadas-->
    <xs:simpleType name="CEDType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z][0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="CCDType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z][0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="CDDType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z][0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="sexoType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[H]|[M]"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="departamentoType">
        <xs:restriction base="xs:string">
            <xs:pattern value="Limpieza|Producción|Contabilidad|Mantenimiento"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="codigoPostType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{5}"/>
        </xs:restriction>
    </xs:simpleType>
    <!--Elemento Raíz-->
    <xs:element name="registroPersonal">
        <xs:complexType>
            <xs:sequence>
                <!--Empleados-->
                <xs:element name="empleados">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="empleado" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nombre" type="xs:string"/>
                                        <xs:element name="sexo" type="sexoType"/>
                                        <xs:element name="contacto">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="email"/>
                                                    <xs:element name="telefono"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="departamento" type="departamentoType"/>
                                    </xs:sequence>
                                    <xs:attribute name="CED" type="CEDType" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <!--Consultores-->
                <xs:element name="consultores">
                    <xs:complexType>
                        <xs:sequence>
                         <xs:element name="consultor" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:sequence>
                                 <xs:element name="nombre" type="xs:string"/>
                                 <xs:element name="sexo" type="sexoType"/>
                                    <xs:element name="contacto">
                                        <xs:complexType>
                                            <xs:sequence>
                                                <xs:element name="email" type="xs:string"/>
                                                <xs:element name="telefono" type="xs:string"/>
                                            </xs:sequence>
                                        </xs:complexType>
                                    </xs:element>
                                 <xs:element name="departamento" type="departamentoType"/>
                                 <xs:element name="empresaExterna" type="xs:string"/>
                                </xs:sequence>
                                <xs:attribute name="CCD" type="CCDType" use="required"/>
                           </xs:complexType>
                         </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <!--Departamentos-->
                <xs:element name="departamentos">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="departamento" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="nombre" type="xs:string"/>
                        <xs:element name="director" type="xs:string"/>
                        <xs:element name="empleados">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="empleado" maxOccurs="unbounded"/>
                                </xs:sequence>
                            </xs:complexType>  
                        </xs:element>
                        <xs:element name="direccion">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="calle" type="xs:string"/>
                                    <xs:element name="ciudad" type="xs:string"/>
                                    <xs:element name="codigoPostal" type="codigoPostType"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                    <xs:attribute name="CDD" type="CDDType" use="required"/>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>